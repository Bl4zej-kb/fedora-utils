[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'im-config.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.gnome.tweaks.desktop', 'org.gnome.SystemMonitor.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Connections.desktop', 'org.gnome.Evince.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
picture-options='zoom'
picture-uri='file:///usr/share/desktop-base/homeworld-theme/wallpaper/gnome-background.xml'
picture-uri-dark='file:///usr/share/desktop-base/homeworld-theme/wallpaper/gnome-background.xml'
primary-color='#ffffff'
secondary-color='#000000'

[break-reminders/eyesight]
play-sound=true

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=true

[calendar]
show-weekdate=false

[datetime]
automatic-timezone=true

[input-sources]
sources=[('xkb', 'pl')]

[interface]
clock-format='24h'
clock-show-seconds=true
clock-show-weekday=false
color-scheme='prefer-dark'
enable-hot-corners=false
gtk-enable-primary-paste=false
icon-theme='Adwaita'

[notifications]
application-children=['org-gnome-software', 'gnome-printers-panel', 'brave-browser', 'org-gnome-nautilus', 'im-riot-riot', 'org-qbittorrent-qbittorrent', 'org-gnome-baobab', 'gimp', 'libreoffice-writer', 'steam', 'org-gnome-terminal', 'com-heroicgameslauncher-hgl', 'clion-clion']

[notifications/application/brave-browser]
application-id='brave-browser.desktop'

[notifications/application/clion-clion]
application-id='clion_clion.desktop'

[notifications/application/com-heroicgameslauncher-hgl]
application-id='com.heroicgameslauncher.hgl.desktop'

[notifications/application/gimp]
application-id='gimp.desktop'

[notifications/application/gnome-printers-panel]
application-id='gnome-printers-panel.desktop'

[notifications/application/im-riot-riot]
application-id='im.riot.Riot.desktop'

[notifications/application/libreoffice-writer]
application-id='libreoffice-writer.desktop'

[notifications/application/org-gnome-baobab]
application-id='org.gnome.baobab.desktop'

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'

[notifications/application/org-gnome-terminal]
application-id='org.gnome.Terminal.desktop'

[notifications/application/org-qbittorrent-qbittorrent]
application-id='org.qbittorrent.qBittorrent.desktop'

[notifications/application/steam]
application-id='steam.desktop'

[peripherals/keyboard]
numlock-state=true

[peripherals/touchpad]
accel-profile='flat'

[screensaver]
picture-options='zoom'
picture-uri='file:///usr/share/desktop-base/homeworld-theme/wallpaper/gnome-background.xml'
primary-color='#ffffff'
secondary-color='#000000'

[search-providers]
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Nautilus.desktop']

[session]
idle-delay=uint32 0

[wm/preferences]
button-layout='appmenu:minimize,maximize,close'
focus-mode='mouse'
